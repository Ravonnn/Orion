# Spotify (Developer Dashboard → your app) — Phase 1+
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Last.fm (https://www.last.fm/api/account/create) — Phase 1+
LASTFM_API_KEY=

# Supabase — local values come from `supabase start` / `pnpm dev`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloud Supabase (optional; used for remote link / deploy)
# NEXT_PUBLIC_SUPABASE_URL=https://ttmekzpgthjzepkllxnt.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 32-byte key, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Expo push + builds
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Errors
SENTRY_DSN=

# App
APP_URL=http://127.0.0.1:3000
MOBILE_SCHEME=orion
